TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
VOBO_JEV_MODE=live
# Opcional: tiempo límite por llamada a JEV en milisegundos (500 a 30000). Por defecto 3000.
# JEV_TIMEOUT_MS=3000
# Opcional: si existe, cuando una acción queda en PEDIR VOBO o BLOQUEAR, VoBo envía un POST JSON a esta URL
# (request_id, decision, tipo_accion, id, explicacion, reglas), con tiempo límite de 2 s y sin reintentos.
# Va después de responder y nunca bloquea ni cambia la respuesta. Sin la variable, no hace nada.
# VOBO_REVIEW_WEBHOOK_URL=https://ejemplo.com/hooks/vobo
# Opcional: clave para /api/v1/evaluate (la ruta para integraciones): se envía como «Authorization: Bearer <clave>».
# Mínimo 16 caracteres; genera una larga y aleatoria. Sin ella esa ruta responde 503 y queda cerrada.
# /api/evaluate (la demo pública) sigue abierta, con o sin esta variable.
# VOBO_API_KEY=
