    {
      "parameters": {
        "jsCode": "// PLACEHOLDER: aquí iría la escritura del registro (por ejemplo, en un CRM, solo como registro).\n// Hoy solo ARMA el objeto y no escribe en ningún sistema.\nconst intentar = (nombre) => { try { const it = $(nombre).first(); return it ? it.json : null; } catch (e) { return null; } };\nconst evaluacion = intentar('Falla cerrada: armar solicitud') ?? intentar('Evaluar con VoBo') ?? {};\nconst ejecutada = intentar('Ejecutar la acción (placeholder)') !== null;\nconst rechazada = intentar('Detener: rechazada') !== null;\nconst bloqueada = intentar('Detener: bloqueada') !== null;\nconst resultado = ejecutada ? 'ejecutada' : rechazada ? 'rechazada por una persona' : bloqueada ? 'bloqueada' : 'sin ejecutar';\nreturn [{ json: { registro: evaluacion.registro ?? null, resultado, escribe_en: 'nada (placeholder)' } }];"
      },
      "id": "21594643-377e-5e44-9a7f-047ba96a87d5",
      "name": "Registrar decisión (placeholder)",
