      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vobo-jev.vercel.app/api/evaluate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "6b77bf6c-5980-5244-84eb-646ffa89e5b7",
      "name": "Evaluar con VoBo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "onError": "continueErrorOutput",
      "notes": "Tiempo límite de 5 s. Si falla (red, tiempo agotado, 5xx, 4xx), la salida de error va a la rama de PEDIR VOBO."
    },
    {
      "parameters": {
        "jsCode": "// FALLA CERRADA: si VoBo no respondió bien (red caída, tiempo agotado, 5xx, 4xx, JSON raro o una decisión\n// desconocida), la acción pasa a una persona. NUNCA a PERMITIR.\nconst ev = $json;\nconst motivo = ev.error?.message ?? ev.message ?? (ev.decision ? 'decisión desconocida: ' + ev.decision : 'sin respuesta de VoBo');\nconst accion = $('Armar la acción').first().json;\nconst resumen = [\n  '*VoBo no pudo evaluar esta acción*',\n  'Acción: ' + accion.tipo_accion + ' a ' + accion.destinatarios + ' destinatario(s) por «' + accion.canal + '»' + (accion.id ? ' (id ' + accion.id + ')' : ''),\n  'Texto: «' + String(accion.texto ?? '').slice(0, 120) + '»',\n  'Por qué: ' + motivo + '. Por seguridad pasa a una persona.',\n].join('\\n');\nreturn [{ json: {\n  decision: 'REVIEW',\n  resumen_aprobacion: resumen,\n  registro: {\n    request_id: null, timestamp: new Date().toISOString(), decision: 'REVIEW', piso_reglas: null, riesgo_jev: null,\n    reglas: '', modelo: null, jev_estado: 'fallo', tipo_accion: accion.tipo_accion, id_accion: accion.id ?? null,\n  },\n} }];"
      },
      "id": "22e083e7-86f9-5047-9464-c25cd1033bcc",
      "name": "Falla cerrada: armar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        520
      ]
    },
