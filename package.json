{
  "name": "vobo-jev",
  "version": "0.1.0",
  "private": true,
  "description": "VoBo: compuerta de políticas para agentes internos de 30X, con JEV (TypeSafe).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "node --env-file-if-exists=.env.local --import tsx scripts/bench.ts",
    "tune": "node --env-file-if-exists=.env.local --import tsx scripts/tune.ts",
    "verify-freeze": "tsx scripts/verify-freeze.ts",
    "build-data": "tsx scripts/build-data.ts",
    "agente-demo": "tsx examples/agente-demo.ts"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
